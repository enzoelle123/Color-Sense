# Credenciais do projeto Supabase.
#
# Onde achar: painel do Supabase > seu projeto > Project Settings > API
#   SUPABASE_URL  = "Project URL"        (ex.: https://abcdefgh.supabase.co)
#   SUPABASE_KEY  = a chave "publishable" / "anon public"
#
# A chave publishable é feita para ficar no cliente — ela vai junto no
# executável e isso é esperado. Quem protege os dados é o Row Level Security,
# não o segredo da chave. Rode supabase/schema.sql antes do primeiro login.
#
# NUNCA coloque aqui a service_role key: ela ignora o RLS por completo.

SUPABASE_URL=
SUPABASE_KEY=
