{
  "name": "colorsense",
  "version": "0.2.0",
  "description": "Ferramenta de acessibilidade visual para pessoas com daltonismo",
  "main": "main.js",
  "scripts": {
    "start": "node run.js",
    "build": "electron-builder"
  },
  "author": "Guilherme Dias, Enzo Sprengoski, Murilo Jeronymo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "electron-store": "^8.2.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.colorsense.app",
    "productName": "ColorSense",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "asarUnpack": [
      "src/native/**"
    ],
    "files": [
      "**/*",
      "!dist",
      "!docs"
    ]
  }
}
