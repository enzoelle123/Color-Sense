{
  "name": "colorsense",
  "version": "0.3.1",
  "description": "Ferramenta de acessibilidade visual para pessoas com daltonismo",
  "main": "main.js",
  "scripts": {
    "start": "node run.js",
    "build": "electron-builder"
  },
  "author": "Guilherme Dias, Enzo Sprengoski, Murilo Jeronymo",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.colorsense.app",
    "productName": "ColorSense",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    },
    "asarUnpack": [
      "src/native/**"
    ],
    "files": [
      "**/*",
      "!dist",
      "!docs",
      "!site"
    ],
    "nsis": {
      "artifactName": "ColorSense-Setup.${ext}"
    },
    "portable": {
      "artifactName": "ColorSense-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "enzoelle123",
        "repo": "Color-Sense"
      }
    ]
  }
}
